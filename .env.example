# =============================================================================
# 康复运动 App · 本机开发环境变量
# =============================================================================
# 复制此文件为 .env 并修改密码后即可 docker compose up -d
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=rehab_mvp
POSTGRES_USER=rehab
POSTGRES_PASSWORD=rehab_dev_password
POSTGRES_PORT=5432

# 动作库 SQL 目录（现有资产，直接挂载）
EXERCISE_SQL_DIR=D:/AI/R/exercises-dataset-main/sql

# ---- Redis ----
REDIS_PORT=6379

# ---- NestJS API ----
API_PORT=3000
CORS_ORIGINS=*

# ---- AI 推理服务 ----
# stub 模式不加载 GPU，安全用于本机 API 测试
# vllm 模式需要 24GB 显存的 GPU + Qwen3-8B 基座权重
AI_MODE=stub
AI_PORT=8000
AI_SHARED_KEY=

# 模型权重路径（仅 AI_MODE=vllm 时需要）
MODEL_PATH=/models/Qwen3-8B
LORA_PATH=/models/rehab-lora
# MODEL_DIR=D:/models  # 宿主机模型目录（GPU 就绪后取消注释）
